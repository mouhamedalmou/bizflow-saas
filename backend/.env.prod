# Production template. Inject real secrets through the deployment environment.
NODE_ENV=production
PORT=5000
MONGODB_URI=<your_mongodb_atlas_uri>
JWT_SECRET=<your_jwt_secret>
CLIENT_URL=https://bizflowsaas.duckdns.org
FRONTEND_URL=https://bizflowsaas.duckdns.org
CORS_ORIGIN=https://bizflowsaas.duckdns.org
API_URL=https://bizflowsaas.duckdns.org/api
AWS_REGION=<your_aws_region>
AWS_BUCKET_NAME=<your_s3_bucket>
AWS_ACCESS_KEY_ID=<your_aws_key>
AWS_SECRET_ACCESS_KEY=<your_aws_secret>
