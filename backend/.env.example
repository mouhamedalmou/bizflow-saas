PORT=5000
NODE_ENV=production

MONGODB_URI=mongodb+srv://username:password@example.mongodb.net/bizflow
JWT_SECRET=replace_with_a_secure_jwt_secret

FRONTEND_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
ALLOWED_ORIGINS=https://bizflowsaas.duckdns.org,http://localhost:3000,http://localhost:5173

AWS_REGION=eu-north-1
AWS_BUCKET_NAME=replace_with_bucket_name
AWS_ACCESS_KEY_ID=replace_with_access_key
AWS_SECRET_ACCESS_KEY=replace_with_secret_key

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=replace_with_email@example.com
EMAIL_PASS=replace_with_app_password
